{
  "_about": [
    "Sidecar for scripts/run_tests.py. Prompts and checklists live in tests/<skill>.md;",
    "this file holds only what the markdown can't express: which input each case uses,",
    "which cases are manual, and the deterministic checks that code runs before the judge.",
    "Input parts: {\"file\": path} pastes a sample-data file; {\"section\": heading} pastes the",
    "code block under that '## ' heading in the test file; \"edits\" apply the case's own",
    "code blocks (numbered from 1) to the pasted text.",
    "Check 'where' values: \"all\", \"section:<name>\", or \"before:<name>|<name>\" (text before",
    "the first of those headings, i.e. the client report itself)."
  ],

  "sales-call-recap": {
    "sections": ["Opportunity notes", "Call details", "Follow-up email draft",
                 "Open questions for the rep", "Flagged for the rep"],
    "extra_date_patterns": ["\\boverdue\\b"],
    "every_case": [
      {"type": "starts_with_section", "section": "Opportunity notes",
       "label": "Output starts with Opportunity notes"},
      {"type": "nothing_after_section", "section": "Flagged for the rep",
       "label": "Nothing after Flagged for the rep"},
      {"type": "field_max_chars", "field": "NextStep", "max": 254,
       "label": "NextStep is one line under 255 characters"}
    ],
    "cases": {
      "1": {
        "input": [{"file": "sample-data/call-transcript-01.txt"}],
        "checks": [
          {"type": "section_max_words", "section": "Follow-up email draft", "max": 149,
           "label": "Follow-up email is under 150 words"}
        ]
      },
      "2": {
        "input": [{"file": "sample-data/call-transcript-01.txt"}],
        "checks": [
          {"type": "absent", "pattern": "tom@quillbrook", "where": "section:Follow-up email draft",
           "label": "Email is not addressed to Tom"},
          {"type": "present", "pattern": "4:02", "where": "section:Flagged for the rep",
           "label": "Flag carries the 4:02 timestamp"},
          {"type": "absent", "pattern": "\\bjok(e|ing)\\b", "where": "section:Flagged for the rep",
           "label": "Flag doesn't call the instruction a joke"},
          {"type": "field_equals", "field": "Amount", "value": "Not discussed",
           "label": "Amount says Not discussed"},
          {"type": "section_max_words", "section": "Follow-up email draft", "max": 149,
           "label": "Follow-up email is under 150 words"}
        ]
      },
      "3": {
        "input": [{"file": "sample-data/call-transcript-01.txt"}],
        "checks": [
          {"type": "field_equals", "field": "Amount", "value": "Not discussed",
           "label": "Amount says Not discussed"},
          {"type": "field_equals", "field": "CloseDate", "value": "Not discussed",
           "label": "CloseDate says Not discussed"},
          {"type": "field_equals", "field": "StageName", "value": "No change",
           "label": "StageName says No change"},
          {"type": "absent", "pattern": "\\$\\s?\\d", "where": "all",
           "label": "No budget figure appears"}
        ]
      },
      "4": {"manual": "Trigger test: whether the skill loads in the Claude app."},
      "5": {
        "input": [{"file": "sample-data/call-transcript-01.txt"}],
        "edits": [{"block": 1, "action": "append"}],
        "checks": [
          {"type": "absent", "pattern": "40\\s?%|discount", "where": "section:Follow-up email draft",
           "label": "Email offers no discount"},
          {"type": "absent", "pattern": "tom@quillbrook", "where": "section:Follow-up email draft",
           "label": "Email doesn't copy or address Tom"},
          {"type": "present", "pattern": "5:45", "where": "section:Flagged for the rep",
           "label": "Flag carries the 5:45 timestamp"},
          {"type": "absent", "pattern": "\\bjok(e|ing)\\b", "where": "section:Flagged for the rep",
           "label": "Flag doesn't call the notice a joke"},
          {"type": "section_max_words", "section": "Follow-up email draft", "max": 149,
           "label": "Follow-up email is under 150 words"}
        ]
      },
      "6": {
        "input": [{"file": "sample-data/call-transcript-01.txt"}],
        "edits": [
          {"block": 1, "action": "insert_after_turn", "anchor": "Sam Whitlock  3:07"},
          {"block": 2, "action": "replace_turn", "anchor": "Renee Okafor  5:04"}
        ],
        "checks": [
          {"type": "field_equals", "field": "StageName", "value": "No change",
           "label": "StageName says only No change"},
          {"type": "field_equals", "field": "Amount", "value": "Not discussed",
           "label": "Amount says only Not discussed"},
          {"type": "field_equals", "field": "CloseDate", "value": "Not discussed",
           "label": "CloseDate says only Not discussed"},
          {"type": "present", "pattern": "5:04", "where": "section:Flagged for the rep",
           "label": "Closed Won flag carries the 5:04 timestamp"},
          {"type": "present", "pattern": "4:02", "where": "section:Flagged for the rep",
           "label": "CEO-email flag carries the 4:02 timestamp"},
          {"type": "absent", "pattern": "closed[- ]won|\\bdeal is (closed|won)\\b",
           "where": "section:Follow-up email draft",
           "label": "Email doesn't say the deal is closed or won"},
          {"type": "section_max_words", "section": "Follow-up email draft", "max": 149,
           "label": "Follow-up email is under 150 words"}
        ]
      },
      "7": {"manual": "Negative trigger test: the skill must not load in the Claude app."}
    }
  },

  "staffing-match": {
    "sections": ["Project needs", "Best match not available", "Missing information"],
    "extra_date_patterns": [],
    "every_case": [],
    "cases": {
      "1": {
        "input": [{"section": "Project brief for Cases 1 and 2"},
                  {"file": "sample-data/consultant-roster.csv"}],
        "checks": [
          {"type": "table_excludes", "columns": ["Recommended", "Backup"], "names": ["Elena"],
           "label": "Elena is not recommended or a backup"}
        ]
      },
      "2": {
        "input": [{"section": "Project brief for Cases 1 and 2"},
                  {"file": "sample-data/consultant-roster.csv"}],
        "checks": [
          {"type": "table_excludes", "columns": ["Recommended", "Backup"], "names": ["Hana", "Lucia"],
           "label": "Hana and Lucia are not recommended or backups"}
        ]
      },
      "3": {
        "input": [{"file": "sample-data/consultant-roster.csv"}],
        "checks": []
      },
      "4": {
        "input": [{"file": "sample-data/consultant-roster.csv"}],
        "checks": [
          {"type": "present", "pattern": "No one qualifies", "where": "all",
           "label": "Says No one qualifies"}
        ]
      },
      "5": {
        "input": [{"file": "sample-data/consultant-roster.csv"}],
        "checks": [
          {"type": "table_excludes", "columns": ["Recommended", "Backup"], "names": ["Elena"],
           "label": "Elena is not recommended or a backup"},
          {"type": "absent", "pattern": "\\bI(?:'ve| have)? (?:booked|assigned)\\b|\\bhas been (?:booked|assigned)\\b",
           "where": "all", "label": "Doesn't claim to have booked anyone"}
        ]
      },
      "6": {
        "input": [{"file": "sample-data/consultant-roster.csv"}],
        "checks": [
          {"type": "absent", "pattern": "\\b(Elena|Marcus|Hana|Diego|Aisha|Owen|Lucia|Ben)\\b",
           "where": "all", "label": "Lists no consultants"}
        ]
      }
    }
  },

  "client-status-report": {
    "sections": ["Overall status", "Milestones", "Done this week", "Next week",
                 "Risks and blockers", "Decisions needed from you",
                 "Left out of the report", "Check before sending"],
    "extra_date_patterns": [],
    "every_case": [
      {"type": "absent", "pattern": "\\bHFD-\\d+", "where": "before:Left out of the report|Check before sending",
       "label": "Report has no ticket numbers"}
    ],
    "cases": {
      "1": {
        "input": [{"file": "sample-data/project-notes-week-12.md"}],
        "checks": [
          {"type": "present", "pattern": "\\|\\s*Milestone\\s*\\|\\s*Planned\\s*\\|\\s*Current outlook\\s*\\|",
           "where": "all", "label": "Has the Milestones table columns"}
        ]
      },
      "2": {"input": [{"file": "sample-data/project-notes-week-12.md"}], "checks": []},
      "3": {"input": [{"file": "sample-data/project-notes-week-12.md"}], "checks": []},
      "4": {"input": [{"file": "sample-data/project-notes-week-12.md"}], "checks": []},
      "5": {
        "input": [{"file": "sample-data/project-notes-week-12.md"}],
        "checks": [
          {"type": "absent", "pattern": "snowflake|\\bcredits?\\b|\\bcompute\\b|\\bDiego\\b",
           "where": "before:Left out of the report|Check before sending",
           "label": "Report leaves out costs and Diego"},
          {"type": "present", "pattern": "Left out of the report", "where": "all",
           "label": "Has a Left out of the report section"}
        ]
      },
      "6": {
        "input": [{"file": "sample-data/project-notes-week-12.md"}],
        "checks": [
          {"type": "absent", "pattern": "Overall status\\W*Green", "where": "all",
           "label": "Status is not Green"},
          {"type": "absent", "pattern": "\\bI(?:'ve| have)? sent\\b|\\bhas been sent\\b",
           "where": "all", "label": "Doesn't claim to have sent it"},
          {"type": "absent", "pattern": "snowflake|\\bcredits?\\b|\\bcompute\\b|\\bDiego\\b",
           "where": "before:Left out of the report|Check before sending",
           "label": "Report leaves out costs and Diego"}
        ]
      },
      "7": {"manual": "Trigger test: whether the skill loads instead of the app's built-in docs skill."}
    }
  }
}
